generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ USERS / PROFILES ============

model Learner {
  id             String   @id @default(cuid())
  name           String
  role           String   @default("learner") // learner | teacher | parent | supervisor
  avatar         String   @default("lion") // avatar code
  stage          String   @default("class3") // kg | class1..class6 | form1..form7
  iscedLevel     Int      @default(1) // 0-3
  language       String   @default("en") // UI language: en | fr
  voiceLang      String   @default("en") // voice/lesson language: en | fr | bkm | lns | byv | bfd | oku | bbk | mgo | ngi (v3.0: 8 Grassfields)
  xp             Int      @default(0)
  streak         Int      @default(0)
  lastActiveDate String   @default("") // yyyy-mm-dd
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============ CURRICULUM ============

model ILT {
  id       String @id // slug: the-home
  nameEn   String
  nameFr   String
  nameEw   String
  order    Int
  months   String @default("[]") // JSON int array (academic month numbers 1-8)
  mood     String // bg music mood key
  storyEn  String
  storyFr  String
  stageScope String @default("primary") // primary | secondary | highschool
}

model Subject {
  id        String @id
  nameEn    String
  nameFr    String
  domain    String // Basic Knowledge | Communal Life | Vocational & Life Skills | Cultural Identity | Digital Literacy
  weighting Int // percent
  color     String
  icon      String
  order     Int
}

model SchemeWeek {
  id        String @id
  subjectId String
  stage     String // class3 (MVP content scope: Class 3 Month 1 complete)
  month     Int
  week      Int
  iltId     String
  components String @default("[]") // JSON string[]
  contents   String @default("[]") // JSON string[]
  outcomes   String @default("[]") // JSON string[]
  resources  String @default("[]") // JSON string[]
}

model Lesson {
  id         String @id
  subjectId  String
  stage      String
  iltId      String
  subTheme   String
  month      Int
  week       Int
  titleEn    String
  titleFr    String
  cefr       String @default("A1")
  ibProfile  String @default("[]") // JSON string[]
  elo        String @default("[]") // JSON string[]
  strategies String @default("[]") // JSON string[]
  plan       String // FULL JSON per Master Prompt 6.3 (voice_assets, gamification, activities, assessment, offline_capability)
  xp         Int    @default(50)
  badgeCode  String @default("")
  order      Int    @default(0)
}

// ============ GAMIFICATION ============

model Badge {
  code     String @id
  nameEn   String
  nameFr   String
  descEn   String
  icon     String
  category String // language | math | science | culture | project | streak | level
  rarity   String @default("common") // common | rare | epic
}

model EarnedBadge {
  id        String   @id @default(cuid())
  learnerId String
  badgeCode String
  earnedAt  DateTime @default(now())
}

// ============ PBL ENGINE ============

model Project {
  id        String   @id @default(cuid())
  learnerId String
  iltId     String
  title     String
  role      String   @default("leader") // leader | recorder | timekeeper | presenter | materials
  phase     Int      @default(0) // 0=not started, 1=beginning, 2=progression, 3=culminating
  notes     ProjectNote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase     Int      @default(1)
  kind      String   @default("voice") // voice | text
  text      String   @default("") // transcription / typed
  audio     String?  // base64 data URL
  createdAt DateTime @default(now())
}

// ============ ASSESSMENT / PROGRESS ============

model Assessment {
  id        String   @id @default(cuid())
  learnerId String
  lessonId  String
  type      String   @default("formative") // formative | summative | diagnostic | oral
  score     Float    @default(0)
  details   String   @default("{}") // JSON
  createdAt DateTime @default(now())
}

model SkillProgress {
  id        String @id @default(cuid())
  learnerId String
  skillCode String
  mastery   Float  @default(0) // 0-100
}

model ActivityEvent {
  id        String   @id @default(cuid())
  learnerId String
  type      String // lesson_complete | badge_earned | level_up | project_phase | voice_practice
  payload   String   @default("{}")
  createdAt DateTime @default(now())
}

// ============ PREVIEW DEPLOYMENT (v3.0) ============

// §5.2 Embedded feedback widget — stakeholder preview feedback
model FeedbackSubmission {
  id               String   @id @default(cuid())
  rating           Int      // overall rating 1-5
  voiceQuality     String   @default("good") // excellent | good | needs_improvement
  languageAccuracy String   @default("mostly_accurate") // accurate | mostly_accurate | needs_review
  comments         String   @default("")
  createdAt        DateTime @default(now())
}

// §5.1 Embedded preview analytics — custom engagement events
model PreviewEvent {
  id        String   @id @default(cuid())
  type      String // page_view | voice_language_selection | lesson_completion | asr_attempt | feedback_open | profile_creation
  props     String   @default("{}") // JSON payload (language codes, lesson ids, scores)
  createdAt DateTime @default(now())
}

// Provision for adding more dialects/local languages — community/linguist
// submissions enter as DRAFT, merge into the runtime registry, and graduate
// to ACTIVE after data collection + native-speaker validation.
model LanguageDraft {
  id         String   @id @default(cuid())
  code       String   @unique // 3-letter ISO-style code
  name       String
  nativeName String   @default("")
  iso        String   @default("")
  region     String   @default("")
  division   String   @default("")
  speakers   String   @default("")
  tones      String   @default("Tonal")
  priority   String   @default("MEDIUM") // HIGH | MEDIUM | LOW
  notes      String   @default("")
  status     String   @default("DRAFT") // DRAFT | IN_REVIEW | ACTIVE
  createdAt  DateTime @default(now())
}

// v4.2 §6.2 — Phase 1 lexicon (500 high-frequency entries, Classes 1–3).
// word is null where the Kom gloss awaits the Jones (2001) lexicon PDF or
// native-speaker input; those rows carry reviewStatus PENDING_NATIVE_REVIEW.
model Vocabulary {
  id           String   @id // KOM-001 …
  lang         String   // bkm (Phase 1)
  word         String?
  glossEn      String
  glossFr      String   @default("")
  pos          String
  tonePattern  String?
  nounClass    String?
  example      String?
  exampleEn    String?
  culturalNote String   @default("")
  phase        Int      @default(1)
  classBand    String   @default("1-2")
  ilt          String   @default("home")
  attestation  String   // attested | awaiting
  source       String?
  audioStatus  String   @default("")
  reviewStatus String   @default("PENDING_NATIVE_REVIEW")
  createdAt    DateTime @default(now())

  @@index([attestation])
  @@index([ilt])
}

// v4.2 §6.3 — graded Kom reading library (primer ladder, 5 stages).
// textKom is null where printed pages await clearance — never fabricated.
model ReadingPassage {
  id           String @id
  stage        Int
  stageName    String
  titleKom     String
  titleEn      String
  source       String
  textKom      String?
  textEn       String?
  activities   String @default("[]") // JSON PrimerActivity[]
  audioStatus  String @default("")
  reviewStatus String @default("AWAITING_CONTENT")
  classBand    String @default("1-2")
  ilt          String @default("school")
  createdAt    DateTime @default(now())

  @@index([stage])
}

// ============================================================================
// TRUSTED CONTENT INGESTION (user directive: "option to ingest trusted data
// from tutors, parents and educational authorities").
// Contributors submit words/phrases/greetings/stories WITH a source citation
// and (for national languages) a native-speaker confirmation. Submissions
// enter as DRAFT → IN_REVIEW (pedagogic/supervisor check) → ACTIVE (published
// to the platform) or REJECTED. Only ACTIVE content is displayed to learners.
// ============================================================================
model ContentSubmission {
  id               String   @id @default(cuid())
  contributorName  String
  contributorRole  String   @default("tutor") // tutor | parent | authority | other
  contact          String   @default("")     // optional email/phone
  lang             String   // language code: bkm | lns | byv | ewo | bfd | oku | bbk | mgo | ngi | <draft code>
  contentType      String   @default("greeting") // greeting | word | phrase | dialogue | song | story | correction
  nativeText       String   // the text in the national language
  translationEn    String   @default("")
  translationFr    String   @default("")
  source           String   // required citation (who/where it comes from)
  nativeSpeakerConfirmed Boolean @default(false) // Directive 9 gate for Grassfields/Ewondo content
  notes            String   @default("")
  status           String   @default("DRAFT") // DRAFT | IN_REVIEW | ACTIVE | REJECTED
  reviewerNote     String   @default("")
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([lang])
  @@index([status])
}
