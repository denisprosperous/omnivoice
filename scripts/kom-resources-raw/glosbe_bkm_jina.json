-5 text-gray-600\" data-element=\"dictionary__source\" data-activator-type=\"main\">\n<span class=\"dictionary__source__name truncate flex-1\">\nKom (Cameroon)\n</span>\n<span>\n<svg class=\"inline-block fillCurrentColor\" width=\"1.25rem\" height=\"1.25rem\" fill=\"currentColor\" viewBox=\"0 0 48 48\">\n<path d=\"m24 30.75-12-12 2.15-2.15L24 26.5l9.85-9.85L36 18.8Z\"></path>\n</svg>\n</span>\n</a>\n</div>\n</div>\n<a href=\"/en/bkm\" class=\"languages__flip p-1 text-gray-700 w-12 border-dashed border-gray-500 rounded-full hover:bg-gray-200 transition-all duration-300 text-sm\" aria-label=\"flip languages\">\n<span>\n<svg class=\"inline-block fillCurrentColor\" width=\"1.25rem\" height=\"1.25rem\" fill=\"currentColor\" viewBox=\"0 0 48 48\">\n<path d=\"M13.55 42 4 32.45l9.6-9.6 2.1 2.1-6 6h32.45v3H9.7l5.95 5.95Zm20.9-16.85-2.1-2.1 5.95-5.95H5.85v-3H38.3l-6-6L34.4 6l9.6 9.6Z\"></path>\n</svg>\n</span>\n</a>\n<div class=\"relative languages__select w-1/2\">\n<div class=\"flex justify-center\">\n<a href=\"/change-dictionary?l1=bkm&amp;l2=en\" rel=\"nofollow\" class=\"flex text-gray-600 w-full md:w-2/3 px-3 py-1 bg-white border border-gray-300 rounded-full hover:bg-gray-200 transition-all duration-500 text-sm leading-5\" data-element=\"dictionary__target\" data-activator-type=\"main\">\n<span class=\"dictionary__target__name truncate flex-1\">\nEnglish\n</span>\n<span>\n<svg class=\"inline-block fillCurrentColor\" width=\"1.25rem\" height=\"1.25rem\" fill=\"currentColor\" viewBox=\"0 0 48 48\">\n<path d=\"m24 30.75-12-12 2.15-2.15L24 26.5l9.85-9.85L36 18.8Z\"></path>\n</svg>\n</span>\n</a>\n</div>\n</div>\n</div>\n</div>\n<div class=\"justify-center items-center h-16 px-2 flex\" id=\"search-container\">\n<div class=\"w-full md:w-2/3 xl:w-1/2 2xl:w-1/3 m-auto\">\n<div>\n<div class=\"w-full relative\">\n<form action=\"/bkm/en\" class=\"flex relative input__without-keyboard\" id=\"dictionary-search-form\">\n<input aria-label=\" SEARCH.searchBoxPlaceholder\" type=\"text\" name=\"q\" id=\"dictionary-search\" spellcheck=\"false\" autocorrect=\"off\" autocomplete=\"off\" autocapitalize=\"none\" class=\"text-gray-800 w-full flex-1 focus:outline-none input__without-keyboard text-lg py-2 px-4 border-2 border-primary-500 focus:border-primary-700 focus:shadow-md rounded-full\" placeholder=\"\nTranslate from Kom (Cameroon) into English\" lang=\"bkm\">\n<script>\n</script>\n<div class=\"flex absolute dir-aware-right-0 h-full text-gray-500\">\n<button class=\"w-8 flex items-center justify-center keyboard-activator\" data-element=\"keyboard\" type=\"button\" aria-label=\"keyboard\">\n<svg viewBox=\"0 0 24 24\" width=\"1.25rem\" height=\"1.25rem\" class=\"fillCurrentColor\"><path d=\"M20 5H4c-1.1 0-1.99.9-1.99 2L2 17c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-9 3h2v2h-2V8zm0 3h2v2h-2v-2zM8 8h2v2H8V8zm0 3h2v2H8v-2zm-1 2H5v-2h2v2zm0-3H5V8h2v2zm9 7H8v-2h8v2zm0-4h-2v-2h2v2zm0-3h-2V8h2v2zm3 3h-2v-2h2v2zm0-3h-2V8h2v2z\"></path></svg>\n</button>\n<button class=\"w-8 flex items-center justify-center\" data-element=\"search\" type=\"submit\" aria-label=\"search\">\n<svg width=\"1.25rem\" height=\"1.25rem\" viewBox=\"0 0 24 24\" class=\"fillCurrentColor\"><path d=\"M15 14h-1l-.3-.3C15 13 16 11 16 9c0-3-3-6-7-6S3 6 3 9s3 7 6 7c2 0 3.1-.6 4-1.6l.3.3v.8l5 5L20 19l-5-5zm-6 0c-2 0-4-2-4-5s2-4 4-4 5 2 5 4-2 5-5 5z\"></path></svg> </button>\n</div>\n</form>\n</div>\n</div>\n<div id=\"search-suggestions-container\" data-main=\"true\"></div>\n</div>\n</div>\n<div class=\"flex items-center justify-center w-full md:w-1/2 lg:w-1/3 m-auto flex-wrap py-4\" id=\"recently-used-dictionaries\">\n</div>\n</div>\n</div>\n</div>\n<div class=\"even:bg-white py-16\">\n<div class=\"text-center text-gray-900 content text-xl\">\nGlosbe is a home for thousands of dictionaries. We provide not only dictionary Kom (Cameroon) - English, but also dictionaries for every existing pairs of languages - online and for free. </div>\n</div>\n<div class=\"bg-gray-50 py-12\">\n<div class=\"content\">\n<div class=\"px-2 gap-4 grid sm:grid-cols-2 md:grid-cols-3\">\n<div class=\"hover:shadow-lg transition-all duration-300 rounded-b-lg border-t-4 border-primary-600 bg-white\">\n<h2 class=\"text-xl font-medium p-2 md:p-4 min-h-32 flex items-center justify-center text-center\">\nTranslations from dictionary Kom (Cameroon) - English, definitions, grammar </h2>\n<p class=\"text-md p-2 md:p-4\">\nIn Glosbe you will find translations from Kom (Cameroon) into English coming from various sources. The translations are sorted from the most common to the less popular. We make every effort to ensure that each expression has definitions or information about the inflection. </p>\n</div>\n<div class=\"hover:shadow-lg transition-all duration-300 rounded-b-lg border-t-4 border-secondary-600 bg-white\">\n<h2 class=\"text-xl font-medium p-2 md:p-4 min-h-32 flex items-center justify-center text-center\">\nIn context translations Kom (Cameroon) - English, translated sentences </h2>\n<p class=\"text-md p-2 md:p-4\">\nGlosbe dictionaries are unique. In Glosbe you can check not only Kom (Cameroon) or English translations. We also offer usage examples showing dozens of translated sentences. You can see not only the translation of the phrase you are searching for, but also how it is translated depending on the context. </p>\n</div>\n<div class=\"hover:shadow-lg transition-all duration-300 rounded-b-lg border-t-4 border-tertiary-600 bg-white\">\n<h2 class=\"text-xl font-medium p-2 md:p-4 min-h-32 flex items-center justify-center text-center\">\nTranslation memory for Kom (Cameroon) - English languages </h2>\n<p class=\"text-md p-2 md:p-4\">\nThe translated sentences you will find in Glosbe come from parallel corpora (large databases with translated texts). Translation memory is like having the support of thousands of translators available in a fraction of a second. </p>\n</div>\n<div class=\"hover:shadow-lg transition-all duration-300 rounded-b-lg border-t-4 border-quaternary-600 bg-white\">\n<h2 class=\"text-xl font-medium p-2 md:p-4 min-h-32 flex items-center justify-center text-center\">\nPronunciation, recordings </h2>\n<p class=\"text-md p-2 md:p-4\">\nOften the text alone is not enough. We also need to hear what the phrase or sentence sounds like. In Glosbe you will find not only translations from the Kom (Cameroon)-English dictionary, but also audio recordings and high-quality computer readers. </p>\n</div>\n<div class=\"hover:shadow-lg transition-all duration-300 rounded-b-lg border-t-4 border-primary-600 bg-white\">\n<h2 class=\"text-xl font-medium p-2 md:p-4 min-h-32 flex items-center justify-center text-center\">\nPicture dictionary </h2>\n<p class=\"text-md p-2 md:p-4\">\nA picture is worth more than a thousand words. In addition to text translations, in Glosbe you will find pictures that present searched terms. </p>\n</div>\n<div class=\"hover:shadow-lg transition-all duration-300 rounded-b-lg border-t-4 border-secondary-600 bg-white\">\n<h2 class=\"text-xl font-medium p-2 md:p-4 min-h-32 flex items-center justify-center text-center\">\nAutomatic Kom (Cameroon) - English translator </h2>\n<p class=\"text-md p-2 md:p-4\">\nDo you need to translate a longer text? No problem, in Glosbe you will find a Kom (Cameroon) - English translator that will easily translate the article or file you are interested in. </p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"pt-32 pb-24 text-2xl text-center text-white\" style=\"background: #19a366 url(/assets/images/world-dotted.png) no-repeat top; background-size: cover\">\n<div class=\"content\">\n<img class=\"w-12 m-auto object-contain\" width=\"48\" height=\"48\" src=\"/assets/images/logo-glosbe-signet-white.svg\" alt=\"\">\n<p>It's nice to welcome you to the Glosbe Community. How about adding entries to the dictionary?</p>\n</div>\n</div>\n<div class=\"py-12 even:bg-slate-100\">\n<div class=\"md:flex w-full content \">\n<div class=\"md:w-1/2\">\n<div class=\"even:bg-slate-100 py-12 text-center\">\n<div class=\"content\">\n<h2 class=\"text-4xl mb-4\">Add translation</h2>\n<div class=\"text-lg\">\n<p class=\"mb-1\">Help us to build the best dictionary.</p>\n<p class=\"mb-1\">Glosbe is a community based project created by people just like you.</p>\n<p class=\"mb-1\">Please, add new entries to the dictionary.</p>\n</div>\n<div class=\"mt-8\">\n<a class=\"text-2xl border-2 border-white shadow bg-secondary-600 text-white px-8 py-2 rounded-full hover:bg-white active:shadow-none hover:border-secondary-600 hover:text-secondary-600\" href=\"/add-translation?l1=bkm&amp;l2=en&amp;phrase=\">\n<span>Add translation</span>\n</a>\n</div>\n</div>\n</div>\n</div>\n<div class=\"md:w-1/2\">\n<h3 class=\"mb-4 text-2xl px-2\">Recent changes</h3>\n<div class=\"text-sm p-2\">\n<a href=\"https://app.glosbe.com/recent?l1=bkm&amp;l2=en&amp;user=\" rel=\"nofollow\">\nmore (Click here to view more recent changes)\n</a>\n</div>\n</div>\n</div>\n</div>\n<div class=\"bg-white text-gray-900 py-12 text-center\">\n<div class=\"flex content flex-wrap\">\n<h3 class=\"w-full text-2xl font-medium py-8\">\nStatistics of the Kom (Cameroon) - English dictionary </h3>\n<!--\n<div class=\"w-1/2\">\n<div class=\"text-2xl\">0</div>\n<div class=\"text-gray-700 text-sm\">\nPhrases </div>\n</div>\n<div class=\"w-1/2\">\n<div class=\"text-2xl\">\n0\n</div>\n<div class=\"text-gray-700 text-sm\">\nExamples </div>\n</div>\n-->\n</div>\n<div class=\"text-sm text-center\">\n<a href=\"https://app.glosbe.com/stats?l1=bkm&amp;l2=en\" rel=\"nofollow\">\nmore (Click here to view statistics)\n</a>\n</div>\n</div>\n<div class=\" even:bg-slate-100 py-12\">\n<div class=\"sm:flex content\">\n<div class=\"w-full sm:w-1/2 text-center mt-8 px-4\">\n<h2 class=\"text-2xl\">\n<a href=\"/bkm\">\nLanguage Kom (Cameroon)\n</a>\n</h2>\n<div class=\"text-gray-600 text-sm mb-2 mt-4\">Region</div>\n<div>Native to: Cameroon\nRegion: North-West Province</div>\n<div class=\"text-gray-600 text-sm mt-4 mb-2\">Users</div>\n<div>230,000</di