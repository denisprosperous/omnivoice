&quot;, &quot;keyword&quot; : &quot;inherited&quot; } ], &quot;lang_name&quot; : &quot;Proto-West Germanic&quot;, &quot;term&quot; : &quot;*mann&quot;, &quot;status&quot; : &quot;ok&quot;, &quot;lang&quot; : &quot;gmw-pro&quot; } ], &quot;keyword_label&quot; : &quot;[[Appendix:Glossary#inherited|Inherited]] from&quot;, &quot;keyword&quot; : &quot;inherited&quot; } ], &quot;lang_name&quot; : &quot;Old English&quot;, &quot;term&quot; : &quot;mann&quot;, &quot;status&quot; : &quot;ok&quot;, &quot;lang&quot; : &quot;ang&quot; } ], &quot;keyword_label&quot; : &quot;From&quot;, &quot;is_group&quot; : true, &quot;keyword&quot; : &quot;affix&quot; } ], &quot;lang_name&quot; : &quot;Old English&quot;, &quot;term&quot; : &quot;wīfmann&quot;, &quot;status&quot; : &quot;ok&quot;, &quot;lang&quot; : &quot;ang&quot; } ], &quot;keyword_label&quot; : &quot;[[Appendix:Glossary#inherited|Inherited]] from&quot;, &quot;keyword&quot; : &quot;inherited&quot; } ], &quot;lang_name&quot; : &quot;Middle English&quot;, &quot;term&quot; : &quot;womman&quot;, &quot;status&quot; : &quot;ok&quot;, &quot;lang&quot; : &quot;enm&quot; } ], &quot;keyword_label&quot; : &quot;[[Appendix:Glossary#inherited|Inherited]] from&quot;, &quot;keyword&quot; : &quot;inherited&quot; } ], &quot;lang_name&quot; : &quot;English&quot;, &quot;term&quot; : &quot;woman&quot;, &quot;status&quot; : &quot;ok&quot;, &quot;lang&quot; : &quot;en&quot; }\"></ul>\n<p>From <span class=\"etyl\"><a href=\"https://en.wikipedia.org/wiki/Middle_English\" class=\"extiw\" title=\"w:Middle English\">Middle English</a></span> <i class=\"Latn mention\" lang=\"enm\"><a href=\"/wiki/womman#Middle_English\" title=\"womman\">womman</a></i>, from earlier <i class=\"Latn mention\" lang=\"enm\"><a href=\"/wiki/wimman#Middle_English\" title=\"wimman\">wimman</a></i>, <i class=\"Latn mention\" lang=\"enm\"><a href=\"/wiki/wifman#Middle_English\" title=\"wifman\">wifman</a></i>, from <span class=\"etyl\"><a href=\"https://en.wikipedia.org/wiki/Old_English\" class=\"extiw\" title=\"w:Old English\">Old English</a></span> <i class=\"Latn mention\" lang=\"ang\"><a href=\"/wiki/wifmann#Old_English\" title=\"wifmann\">wīfmann</a></i> <span class=\"mention-gloss-paren annotation-paren\">(</span><span class=\"mention-gloss-double-quote\">“</span><span class=\"mention-gloss\">woman</span><span class=\"mention-gloss-double-quote\">”</span>, literally <span class=\"mention-gloss-double-quote\">“</span><span class=\"mention-gloss\">female person</span><span class=\"mention-gloss-double-quote\">”</span><span class=\"mention-gloss-paren annotation-paren\">)</span>, a compound of <i class=\"Latn mention\" lang=\"ang\"><a href=\"/wiki/wif#Old_English\" title=\"wif\">wīf</a></i> <span class=\"mention-gloss-paren annotation-paren\">(</span><span class=\"mention-gloss-double-quote\">“</span><span class=\"mention-gloss\">woman, female</span><span class=\"mention-gloss-double-quote\">”</span>, <span class=\"ann-pos\">whence <span class=\"etyl\"><a href=\"https://en.wikipedia.org/wiki/English_language\" class=\"extiw\" title=\"w:English language\">English</a></span> <i class=\"Latn mention\" lang=\"en\"><a href=\"/wiki/wife#English\" title=\"wife\">wife</a></i></span><span class=\"mention-gloss-paren annotation-paren\">)</span> +‎ <i class=\"Latn mention\" lang=\"ang\"><a href=\"/wiki/mann#Old_English\" title=\"mann\">mann</a></i> <span class=\"mention-gloss-paren annotation-paren\">(</span><span class=\"mention-gloss-double-quote\">“</span><span class=\"mention-gloss\">person, human being</span><span class=\"mention-gloss-double-quote\">”</span>, <span class=\"ann-pos\">whence <span class=\"etyl\"><a href=\"https://en.wikipedia.org/wiki/English_language\" class=\"extiw\" title=\"w:English language\">English</a></span> <i class=\"Latn mention\" lang=\"en\"><a href=\"/wiki/man#English\" title=\"man\">man</a></i></span><span class=\"mention-gloss-paren annotation-paren\">)</span>. For details on the pronunciation and spelling history, see the usage notes below.\n</p><p>Cognate with <span class=\"etyl\"><a href=\"https://en.wikipedia.org/wiki/Scots_language\" class=\"extiw\" title=\"w:Scots language\">Scots</a></span> <i class=\"Latn mention\" lang=\"sco\"><a class=\"mw-selflink-fragment\" href=\"#Scots\">woman</a></i>, <i class=\"Latn mention\" lang=\"sco\"><a href=\"/wiki/weman#Scots\" title=\"weman\">weman</a></i> <span class=\"mention-gloss-paren annotation-paren\">(</span><span class=\"mention-gloss-double-quote\">“</span><span class=\"mention-gloss\">woman</span><span class=\"mention-gloss-double-quote\">”</span><span class=\"mention-gloss-paren annotation-paren\">)</span>, <span class=\"etyl\"><a href=\"https://en.wikipedia.org/wiki/Saterland_Frisian_language\" class=\"extiw\" title=\"w:Saterland Frisian language\">Saterland Frisian</a></span> <i class=\"Latn mention\" lang=\"stq\"><a href=\"/wiki/Wieuwmoanske#Saterland_Frisian\" title=\"Wieuwmoanske\">Wieuwmoanske</a></i> <span class=\"mention-gloss-paren annotation-paren\">(</span><span class=\"mention-gloss-double-quote\">“</span><span class=\"mention-gloss\">female person, female human, woman</span><span class=\"mention-gloss-double-quote\">”</span><span class=\"mention-gloss-paren annotation-paren\">)</span>. Similar construction can be found in <span class=\"etyl\"><a href=\"https://en.wikipedia.org/wiki/West_Frisian_language\" class=\"extiw\" title=\"w:West Frisian language\">West Frisian</a></span> <i class=\"Latn mention\" lang=\"fy\"><a href=\"/wiki/frommes#West_Frisian\" title=\"frommes\">frommes</a></i> <span class=\"mention-gloss-paren annotation-paren\">(</span><span class=\"mention-gloss-double-quote\">“</span><span class=\"mention-gloss\">woman, girl</span><span class=\"mention-gloss-double-quote\">”</span><span class=\"mention-gloss-paren annotation-paren\">)</span> (from <i class=\"Latn mention\" lang=\"fy\"><a href=\"/wiki/frou#West_Frisian\" title=\"frou\">frou</a></i> and <i class=\"Latn mention\" lang=\"fy\"><a href=\"/wiki/minske#West_Frisian\" title=\"minske\">minske</a></i>, literally \"woman human\") and <span class=\"etyl\"><a href=\"https://en.wikipedia.org/wiki/Afrikaans\" class=\"extiw\" title=\"w:Afrikaans\">Afrikaans</a></span> <i class=\"Latn mention\" lang=\"af\"><a href=\"/w/index.php?title=vroumens&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"vroumens (page does not exist)\">vroumens</a></i> <span class=\"mention-gloss-paren annotation-paren\">(</span><span class=\"mention-gloss-double-quote\">“</span><span class=\"mention-gloss\">woman</span><span class=\"mention-gloss-double-quote\">”</span>, literally <span class=\"mention-gloss-double-quote\">“</span><span class=\"mention-gloss\">woman-person</span><span class=\"mention-gloss-double-quote\">”</span><span class=\"mention-gloss-paren annotation-paren\">)</span>.\n</p>\n<div class=\"NavFrame\">\n<div class=\"NavHead\" style=\"text-align: left; cursor: pointer;\"><span class=\"NavToggle\" data-nosnippet=\"\"><a role=\"button\" tabindex=\"0\">show ▼</a></span>Further information on vocalic development</div>\n<div class=\"NavContent columns-bg ul-column-count\" data-column-count=\"2\" style=\"text-align: left; display: none;\">\n<p>The current pronunciation of the first vowel of the singular began to appear in western England in the 13th century under the rounding influence of the <i>w</i>, though the older pronunciation with <span class=\"IPA nowrap\">/i/</span> (→ modern <span class=\"IPA nowrap\">/ɪ/</span>) remained in use into the 15th century. Although the vowel of the plural was sometimes also altered to <span class=\"IPA nowrap\">/u/</span> (→ modern <span class=\"IPA nowrap\">/ʊ/</span>)  beginning in the 14th century, the pronunciation with <span class=\"IPA nowrap\">/ɪ/</span> ultimately won out there, possibly under the influence of pairs like <i>foot</i>–<i>feet</i>. However, some speakers (especially of <a href=\"https://en.wikipedia.org/wiki/New_Zealand_English\" class=\"extiw\" title=\"w:New Zealand English\">New Zealand English</a> or <a href=\"https://en.wikipedia.org/wiki/South_African_English\" class=\"extiw\" title=\"w:South African English\">South African English</a>) have either retained or reinnovated the pronunciation of the plural with <span class=\"IPA nowrap\">/ʊ/</span>. The modern spelling <i>women</i> for the plural is due to influence of the singular; it is attested from the 15th century.\n</p><p>For a time in the 16th and 17th centuries, the pronunciation of the singular sometimes drifted even further back towards <span class=\"IPA nowrap\">/uː/</span> or <span class=\"IPA nowrap\">/ɔː~oː/</span> (→ modern <span class=\"IPA nowrap\">/oʊ~əʊ/</span>) and the plural sometimes drifted even further forward towards <span class=\"IPA nowrap\">/iː/</span>, leading to comparisons of the words to \"woe man\" or \"we men\".)<sup id=\"cite_ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">[</span>1<span class=\"cite-bracket\">]</span></a></sup><sup id=\"cite_ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">[</span>2<span class=\"cite-bracket\">]</span></a></sup><sup id=\"cite_ref-3\" class=\"reference\"><a href=\"#cite_note-3\"><span class=\"cite-bracket\">[</span>3<span class=\"cite-bracket\">]</span></a></sup><sup id=\"cite_ref-Upward-Davidson_4-0\" class=\"reference\"><a href=\"#cite_note-Upward-Davidson-4\"><span class=\"cite-bracket\">[</span>4<span class=\"cite-bracket\">]</span></a></sup>\n</p>\n</div></div>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Pronunciation\">Pronunciation</h3><span class=\"mw-editsection\" data-nosnippet=\"\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=woman&amp;action=edit&amp;section=3\" title=\"Edit section: Pronunciation\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li><span class=\"ib-brac qualifier-brac\">(</span><span class=\"ib-content qualifier-content\"><span class=\"usage-label-accent\"><a href=\"https://en.wikipedia.org/wiki/Received_Pronunciation\" class=\"extiw\" title=\"w:Received Pronunciation\">Received Pronunciation</a><span class=\"ib-comma label-comma\">,</span> <a href=\"https://en.wikipedia.org/wiki/General_American_English\" class=\"extiw\" title=\"w:General American English\">General American</a><span class=\"ib-comma label-comma\">,</span> <a href=\"https://en.wikipedia.org/wiki/Australian_English_phonology\" class=\"extiw\" title=\"w:Australian English phonology\">Australia</a><span class=\"ib-comma label-comma\">,</span> <a href=\"https://en.wikipedia.org/wiki/New_Zealand_English_phonology\" class=\"extiw\" title=\"w:New Zealand English phonology\">New Zealand</a></span></span><span class=\"ib-brac qualifier-brac\">)</span> <a href=\"/wiki/Wiktionary:International_Phonetic_Alphabet\" title=\"Wiktionary:International Phonetic Alphabet\">IPA</a><sup>(<a href=\"/wiki/Appendix:English_pronunciation\" title=\"Appendix:English pronunciation\">key</a>)</sup>: <span class=\"IPA nowrap\">/ˈwʊmən/</span>\n<ul><li><style data-mw-deduplicate=\"TemplateStyles:r50165410\">.mw-parser-output .k-player .k-attribution{visibility:hidden}</style><table class=\"audiotable\" style=\"vertical-align: middle; display: inline-block; list-style: none; line-height: 1em; border-collapse: collapse; margin: 0;\"><tbody><tr><td>Audio <span class=\"ib-brac qualifier-brac\">(</span><span class=\"usage-label-accent\"><span class=\"ib-content label-content\"><a href=\"https://en.wikipedia.org/wiki/American_English\" class=\"extiw\" title=\"w:American English\">US</a></span></span><span class=\"ib-brac qualifier-brac\">)</span><span class=\"ib-colon qualifier-colon\">:</span></td><td class=\"audiofile\"><span typeof=\"mw:File\"><span><span class=\"mw-tmh-player audio mw-file-element\" style=\"width:175px;\"><audio id=\"mwe_player_0_placeholder\" preload=\"none\" data-mw-tmh=\"\" class=\"\" width=\"175\" style=\"width:175px;\" data-durationhin