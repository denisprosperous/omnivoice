k\"><span class=\"etyl\">Proto-Indo-European</span> <span class=\"etytree-term\"><i class=\"Latn mention\" lang=\"ine-pro\"><a href=\"/wiki/Reconstruction:Proto-Indo-European/mon-\" title=\"Reconstruction:Proto-Indo-European/mon-\">*mon-</a></i></span></div><span class=\"etytree-connector-vertical\"></span><div class=\"etytree-block\"><span class=\"etyl\">Proto-Germanic</span> <span class=\"etytree-term\"><i class=\"Latn mention\" lang=\"gem-pro\"><a href=\"/wiki/Reconstruction:Proto-Germanic/mann-\" title=\"Reconstruction:Proto-Germanic/mann-\">*mann-</a></i></span></div><span class=\"etytree-connector-vertical\"></span><div class=\"etytree-block\"><span class=\"etyl\">Proto-West Germanic</span> <span class=\"etytree-term\"><i class=\"Latn mention\" lang=\"gmw-pro\"><a href=\"/wiki/Reconstruction:Proto-West_Germanic/mann\" title=\"Reconstruction:Proto-West Germanic/mann\">*mann</a></i></span></div><span class=\"etytree-connector-vertical\"></span><div class=\"etytree-block\"><span class=\"etyl\">Old English</span> <span class=\"etytree-term\"><i class=\"Latn mention\" lang=\"ang\"><a href=\"/wiki/mann#Old_English\" title=\"mann\">mann</a></i></span></div><span class=\"etytree-branch-right\"></span></div></div><span class=\"etytree-connector-vertical\"></span><div class=\"etytree-block\"><span class=\"etyl\">Old English</span> <span class=\"etytree-term\"><i class=\"Latn mention\" lang=\"ang\"><a href=\"/wiki/wifmann#Old_English\" title=\"wifmann\">wīfmann</a></i></span></div><span class=\"etytree-connector-vertical\"></span><div class=\"etytree-block\"><span class=\"etyl\">Middle English</span> <span class=\"etytree-term\"><i class=\"Latn mention\" lang=\"enm\"><a href=\"/wiki/womman#Middle_English\" title=\"womman\">womman</a></i></span></div><span class=\"etytree-connector-vertical\"></span><div class=\"etytree-block\"><span class=\"etyl\">English</span> <span class=\"etytree-term\"><i class=\"Latn mention\" lang=\"en\"><strong class=\"selflink\">woman</strong></